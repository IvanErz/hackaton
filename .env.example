# Copy to .env.local and set your browser API key.
#
# --- Google Cloud (same project as this key) ---
#
# Enable these APIs (APIs & Services → Library):
#   - Maps JavaScript API     (map + markers)
#   - Places API (New)        (PlaceAutocompleteElement / Autocomplete widget)
#
# The destination search uses google.maps.places.PlaceAutocompleteElement and
# google.maps.importLibrary("places"). You do not need the legacy "Places API"
# product for that widget (see Places API migration docs).
#
# Billing must be linked to the project for typical Maps/Places usage.
#
# --- API key restrictions (Credentials → your key) ---
#
# Application restrictions: HTTP referrers (web), e.g.
#   http://localhost:3000/*
#   http://localhost:3001/*
#   https://yourdomain.com/*
#
# API restrictions: include at least:
#   - Maps JavaScript API
#   - Places API (New)
#
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Google AI Studio (Gemini) — server only, never NEXT_PUBLIC_ ---
#
# Create a key at https://aistudio.google.com/apikey and paste it here.
# Used by POST /api/zone to classify addresses against the Zagreb zone excerpt.
#
GEMINI_API_KEY=
# Optional override (default in code: gemini-2.0-flash)
# GEMINI_MODEL=
